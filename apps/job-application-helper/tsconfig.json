{
  "extends": "@repo/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    // This is a leaf app (never imported by another package), so declaration
    // output is meaningless here — and next-auth's inferred return types
    // reference its internal (non-public) type paths, which trips
    // declaration-portability checks (TS2883) if left on.
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
