# Canonical site origin, used for metadata, canonical URLs, sitemap, and robots.
# Set this in the Vercel project's Environment Variables (Production + Preview).
NEXT_PUBLIC_SITE_URL="https://mehmetunubol.com"

# Optional: Google Search Console verification token (the value from the
# "HTML tag" verification method, i.e. the content of the meta tag).
GOOGLE_SITE_VERIFICATION=""
