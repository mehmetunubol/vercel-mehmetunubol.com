# Neon Postgres connection string (use a separate Neon project/database from other apps)
DATABASE_URL=
# openssl rand -base64 32
AUTH_SECRET=
# Vercel sets this automatically for cron requests; any random string locally
CRON_SECRET=
# Local development against a plain Postgres instead of Neon
# DATABASE_DRIVER=pg
# Only needed outside Vercel (e.g. `next start` locally); Vercel sets it automatically
# AUTH_TRUST_HOST=true
